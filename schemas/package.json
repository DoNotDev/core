{
  "name": "@donotdev/schemas",
  "version": "0.1.42",
  "private": true,
  "type": "module",
  "description": "Validation schemas and type generation for DoNotDev",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsc --noEmit --watch --listFiles false --listEmittedFiles false",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "type-check": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@donotdev/types": "workspace:*",
    "@donotdev/utils": "workspace:*"
  },
  "peerDependencies": {
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "valibot": "^1.2.0"
  },
  "peerDependenciesMeta": {},
  "license": "MIT"
}
