{
  "name": "@donotdev/core",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "DoNotDev Framework - Core package with all internal modules",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./server": {
      "types": "./server.ts",
      "import": "./server.ts",
      "default": "./server.ts"
    },
    "./vite": {
      "types": "./config/vite/index.d.ts",
      "import": "./config/vite/index.js",
      "default": "./config/vite/index.js"
    },
    "./next": {
      "types": "./config/next/index.d.ts",
      "import": "./config/next/index.js",
      "default": "./config/next/index.js"
    },
    "./functions": {
      "types": "./config/functions/index.d.ts",
      "import": "./config/functions/index.js",
      "default": "./config/functions/index.js"
    },
    "./empty": {
      "import": "./config/empty.cjs",
      "default": "./config/empty.cjs"
    }
  },
  "files": [
    "dist",
    "guidelines",
    "i18n/locales",
    "config/**/*.js",
    "config/**/*.cjs",
    "config/**/*.d.ts",
    "package.json",
    "README.md",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@donotdev/components": "^0.2.0",
    "@sentry/react": "^10.39.0",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^0.575.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "valibot": "^1.5.0",
    "zustand": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "@sentry/react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/donotdev/core.git"
  },
  "keywords": [
    "donotdev",
    "dndev",
    "framework",
    "react",
    "typescript",
    "vite",
    "nextjs",
    "i18n",
    "state-management",
    "zustand"
  ],
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "type-check": "bunx tsc --noEmit"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-destructuring": "^7.29.13",
    "@babel/plugin-transform-parameters": "^7.29.7",
    "@clack/prompts": "^1.8.1",
    "@donotdev/config": "workspace:*",
    "@donotdev/hooks": "workspace:*",
    "@donotdev/i18n": "workspace:*",
    "@donotdev/schemas": "workspace:*",
    "@donotdev/stores": "workspace:*",
    "@donotdev/types": "workspace:*",
    "@donotdev/utils": "workspace:*",
    "@rollup/plugin-strip": "^3.0.4",
    "@tanstack/react-query": "^5.107.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "fast-glob": "^3.3.3",
    "postcss": "^8.5.32",
    "postcss-import": "^16.2.0",
    "postcss-nesting": "^14.0.3",
    "rollup-plugin-visualizer": "^6.0.11",
    "vite-plugin-pwa": "^1.3.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "devDependencies": {
    "@donotdev/components": "workspace:*",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^0.575.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-refresh": "^0.18.0",
    "typescript": "^5.9.3",
    "valibot": "^1.5.0",
    "vite": "^7.3.7",
    "zustand": "^5.1.0"
  }
}
