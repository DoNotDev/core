{
  "name": "@donotdev/utils",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Utility functions for DoNotDev",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    }
  },
  "scripts": {
    "dev": "tsc --noEmit --watch --listFiles false --listEmittedFiles false",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "type-check": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@donotdev/components": "workspace:*",
    "@donotdev/types": "workspace:*",
    "@tanstack/react-query": "^5.107.1"
  },
  "devDependencies": {
    "@sentry/react": "^10.78.0",
    "firebase": "^13.2.0",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "react-i18next": "^17.1.13",
    "valibot": "^1.5.0",
    "zustand": "^5.1.0"
  },
  "peerDependencies": {
    "@sentry/react": "^10.78.0",
    "zustand": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "@sentry/react": {
      "optional": true
    }
  },
  "license": "MIT"
}
