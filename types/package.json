{
  "name": "@donotdev/types",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript types for DoNotDev packages",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsc --noEmit --watch --listFiles false --listEmittedFiles false",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "type-check": "bunx tsc --noEmit"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@hookform/resolvers": "^5.9.2",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.13",
    "valibot": "^1.5.0"
  },
  "dependencies": {},
